{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pencil-echo/canvas-commands-v1",
  "title": "Pencil Echo canvas commands (version 3)",
  "description": "Model answer for one AI request. Spec: docs/api/canvas-commands-v1.md. The app's validator is authoritative; limits in descriptions are enforced there. The app still accepts version 1 and version 2 answers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operations",
    "message"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        3
      ],
      "description": "Version 3 adds diagram strokes, labels and page-coordinate ink. The app still accepts version 1 and version 2 answers."
    },
    "operations": {
      "type": "array",
      "description": "1 to 20 operations, applied together as one undo step.",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "description": "Add a new editable object to the captured page.",
            "additionalProperties": false,
            "required": [
              "op",
              "type",
              "source",
              "placement",
              "frame"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "add_object"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "markdown",
                  "latex",
                  "plot"
                ],
                "description": "text: plain text, written in a handwriting style. markdown: Markdown with $...$ and $$...$$ math. latex: one standalone formula without $ delimiters. plot: a function graph; source is lines 'y = <expression in x>' (1 to 4), optional 'x: <min> .. <max>', 'y: <min> .. <max>' and 'title: <text>'."
              },
              "source": {
                "type": "string",
                "description": "Editable content, 1 byte to 20 KB UTF-8, not only whitespace."
              },
              "placement": {
                "type": "string",
                "enum": [
                  "right_of_scope",
                  "below_scope",
                  "at_frame"
                ],
                "description": "Where to place the object relative to the captured region. at_frame requires frame; the others require frame null."
              },
              "frame": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Page coordinates in points, origin top-left. Only with placement at_frame.",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "description": "At least 8, at most the page width."
                  },
                  "height": {
                    "type": "number",
                    "description": "At least 8, at most the page height. A starting size; the object may grow to fit."
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "description": "Replace the source of an existing object. Only when the request allows replacement.",
            "additionalProperties": false,
            "required": [
              "op",
              "objectId",
              "source"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "edit_object"
                ]
              },
              "objectId": {
                "type": "string",
                "description": "UUID of an object inside the captured region."
              },
              "source": {
                "type": "string",
                "description": "1 byte to 20 KB UTF-8."
              }
            }
          },
          {
            "type": "object",
            "description": "Delete an existing object. Only when the request allows replacement.",
            "additionalProperties": false,
            "required": [
              "op",
              "objectId"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "delete_object"
                ]
              },
              "objectId": {
                "type": "string",
                "description": "UUID of an object inside the captured region."
              }
            }
          },
          {
            "type": "object",
            "description": "Draw native ink: a sketch, picture, diagram, arrow or annotation. Local points sit in a width x height box, origin top-left, y down, and the app scales the box into place. Page points (coordinates page) are page points: width and height are null and frame is null.",
            "additionalProperties": false,
            "required": [
              "op",
              "coordinates",
              "width",
              "height",
              "strokes",
              "labels",
              "placement",
              "frame"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "draw_ink"
                ]
              },
              "coordinates": {
                "type": "string",
                "enum": [
                  "local",
                  "page"
                ],
                "description": "local: points are in the width x height box. page: points are page points for ink drawn on existing work; width and height are null, placement is at_frame and frame is null."
              },
              "width": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Local box width, 16 to 2000. Null when coordinates is page."
              },
              "height": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Local box height, 16 to 2000. Null when coordinates is page."
              },
              "strokes": {
                "type": "array",
                "description": "1 to 64 strokes. After wave and zigzag expansion, arrowheads and fills, at most 2048 points in all.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "points",
                    "closed",
                    "color",
                    "size",
                    "arrow",
                    "fill",
                    "amplitude",
                    "wavelength",
                    "center",
                    "radiusX",
                    "radiusY",
                    "startAngle",
                    "sweep"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "line",
                        "polyline",
                        "smooth",
                        "ellipse",
                        "arc",
                        "rect",
                        "wave",
                        "zigzag"
                      ],
                      "description": "line: 2 points. polyline: straight segments. smooth: a curve through the points. ellipse and rect: 2 points, opposite corners. arc: points is empty; use center, radiusX, radiusY, startAngle and sweep (degrees, y down). wave and zigzag: the spine in points, plus amplitude and wavelength."
                    },
                    "points": {
                      "type": "array",
                      "description": "[x, y] pairs. 2 points for line, ellipse and rect; 2 to 128 for polyline, smooth, wave and zigzag; empty for arc.",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "closed": {
                      "type": "boolean",
                      "description": "Joins the last point to the first. fill paints the interior only when this is true, or when kind is ellipse or rect."
                    },
                    "arrow": {
                      "type": "string",
                      "enum": [
                        "none",
                        "end",
                        "start",
                        "both",
                        "mid"
                      ],
                      "description": "Arrowhead at the end, the start, both, or halfway along. none draws no arrowhead."
                    },
                    "fill": {
                      "type": "boolean",
                      "description": "Paint the interior of a closed shape."
                    },
                    "amplitude": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "wave and zigzag only, 0.5 to 400. Null otherwise."
                    },
                    "wavelength": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "wave and zigzag only, 4 to 2000. Null otherwise."
                    },
                    "center": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "description": "arc only: [x, y]. Null otherwise.",
                      "items": {
                        "type": "number"
                      }
                    },
                    "radiusX": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "arc only, 1 to 2000. Null otherwise."
                    },
                    "radiusY": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "arc only, 1 to 2000. Null otherwise."
                    },
                    "startAngle": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "arc only, degrees from -1080 to 1080. 0 points right. Null otherwise."
                    },
                    "sweep": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "arc only, degrees from -1080 to 1080, not 0. Positive sweep goes clockwise. Null otherwise."
                    },
                    "color": {
                      "type": "string",
                      "enum": [
                        "black",
                        "gray",
                        "blue",
                        "red",
                        "green",
                        "orange",
                        "purple",
                        "brown",
                        "yellow",
                        "pink"
                      ]
                    },
                    "size": {
                      "type": "number",
                      "description": "Pen width in page points, 1 to 24; about 3 for outlines."
                    }
                  }
                }
              },
              "labels": {
                "type": "array",
                "description": "0 to 16 short labels placed with the drawing. Each text is at most 40 bytes.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "text",
                    "x",
                    "y"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "text",
                        "latex"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              },
              "placement": {
                "type": "string",
                "enum": [
                  "right_of_scope",
                  "below_scope",
                  "at_frame"
                ],
                "description": "at_frame requires frame and may overlap existing ink, for annotations; the others require frame null."
              },
              "frame": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Page coordinates in points, origin top-left. Only with placement at_frame.",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "description": "At least 8, at most the page width."
                  },
                  "height": {
                    "type": "number",
                    "description": "At least 8, at most the page height. A starting size; the object may grow to fit."
                  }
                }
              }
            }
          }
        ]
      }
    },
    "message": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional chat text for the conversation, at most 4 KB. Never placed on the page."
    }
  }
}
